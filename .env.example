APP_HOST=127.0.0.1
APP_PORT=8000

DB_PATH=./data/app.db
LOG_PATH=./logs/app.log

# Optional proxy (keep empty by default)
HTTP_PROXY_URL=

# CSGORoll pagination scan config
ROLL_PAGE_SIZE=250
ROLL_PAGES_PER_LOOP=8
ROLL_INTRA_PAGE_DELAY_SECONDS=0.05
ROLL_MULTI_ITEM_MODE=split_items
ROLL_REFRESH_MODE=continuous
ROLL_DAILY_REFRESH_HOUR=9
ROLL_DAILY_REFRESH_MINUTE=0
ROLL_DAILY_FRESH_SECONDS=93600
ROLL_STATUS=LISTED
ROLL_ORDER_BY=TOTAL_VALUE_DESC
ROLL_BASE_INTERVAL_SECONDS=0.6
ROLL_JITTER_SECONDS=0.2
ROLL_TRADE_TTL_SECONDS=1800
ROLL_MAX_RETRIES=3
ROLL_EXCLUDED_CATEGORIES=shotgun,shotguns,machinegun,machineguns,stickers,others

# Youpin cache config
YOUPIN_TTL_SECONDS=60
YOUPIN_PRIORITY_TTL_SECONDS=30
YOUPIN_HIGH_PRIORITY_TTL_SECONDS=10
YOUPIN_BATCH_SIZE=60
YOUPIN_REFRESH_WORKERS=8
YOUPIN_CYCLE_TIME_BUDGET_SECONDS=60
YOUPIN_PER_REQUEST_DELAY_SECONDS=0.08
YOUPIN_MAX_RETRIES=3
YOUPIN_FAILURE_RETRY_BASE_SECONDS=20
YOUPIN_FAILURE_RETRY_MAX_SECONDS=600
YOUPIN_RATE_LIMIT_RETRY_BASE_SECONDS=30
YOUPIN_RATE_LIMIT_RETRY_MAX_SECONDS=1200
YOUPIN_EMPTY_PRICE_RETRY_BASE_SECONDS=60
YOUPIN_EMPTY_PRICE_RETRY_MAX_SECONDS=1800
YOUPIN_EMPTY_WARN_MIN_ATTEMPTS=20
YOUPIN_EMPTY_WARN_RATE=0.35
# Optional: connect to an already logged-in Chrome/Edge via CDP.
# Example launch arg: --remote-debugging-port=9222
YOUPIN_BROWSER_CONTEXT_ENABLED=false
YOUPIN_BROWSER_CONTEXT_CDP_URL=http://127.0.0.1:9222
YOUPIN_BROWSER_CONTEXT_PAGE_URL=https://www.youpin898.com/
YOUPIN_BROWSER_CONTEXT_TIMEOUT_SECONDS=20
SPECIAL_DETAIL_BATCH_SIZE=8
SPECIAL_DETAIL_PAUSE_NORMAL_QUEUE=false

# top-markup bucket strategy: min / avg / median
TOP_BUCKET_STRATEGY=min
ROLL_TARGET_MARKUP_PERCENT=11.5
ROLL_TARGET_MARKUP_EPS=0.02

# price normalization / pnl model
# Suggested calibration bands from current matched sample ratio (youpin_sell_price / roll_raw_price):
# conservative=3.92, neutral=4.06, optimistic=4.13
ROLL_TO_YOUPIN_RATE=4.06
PLATFORM_FEE_RATE=0.025
WITHDRAW_LOSS_RATE=0.01

# Exchange rate auto update (exchangerate.host)
EXCHANGE_RATE_ENABLED=1
EXCHANGE_RATE_PRIMARY_SOURCE=frankfurter
EXCHANGE_RATE_BACKUP_SOURCE=open_er_api
EXCHANGE_RATE_BASE=USD
EXCHANGE_RATE_TARGET=CNY
EXCHANGE_RATE_REFRESH_SECONDS=120
EXCHANGE_RATE_TIMEOUT_SECONDS=8
# Max backoff when exchange API fails
EXCHANGE_RATE_MAX_BACKOFF_SECONDS=900
# Manual override protection window (0 = always allow auto update)
EXCHANGE_RATE_MANUAL_OVERRIDE_SECONDS=0
# ROLL coin to USD conversion multiplier (1 coin ~= 1 USD by default)
ROLL_COIN_TO_USD_RATE=1.0

# Auto download mapper files on startup
MAPPER_AUTO_DOWNLOAD=true
MAPPER_REFRESH_SECONDS=86400
MAPPER_UUYP_URL=https://raw.githubusercontent.com/EricZhu-42/SteamTradingSite-ID-Mapper/main/uuyp/730.json
MAPPER_STEAM_URL=https://raw.githubusercontent.com/EricZhu-42/SteamTradingSite-ID-Mapper/main/steam/730.json
MAPPER_UUYP_FILE=./data/mappings/uuyp_730.json
MAPPER_STEAM_FILE=./data/mappings/steam_730.json

# Optional paid source placeholder
PRICEMPIRE_API_KEY=
PRICEMPIRE_ENDPOINT=https://api.pricempire.com/v3/getAllItems

# data authenticity verification scheduler
VERIFY_ENABLED=true
VERIFY_INTERVAL_SECONDS=300
VERIFY_SAMPLE_SIZE=5
VERIFY_CHECK_LIVE_YOUPIN=false
YOUPIN_FRESH_SECONDS=300
ROLL_FRESH_SECONDS=300
AUTO_VERIFY_PROFIT_THRESHOLD=10
AUTO_VERIFY_MAX_BATCH=50
SHOW_ONLY_FRESH_BY_DEFAULT=true
DEFAULT_API_ONLY_VERIFIED=true
SERVING_FRESH_SECONDS=120
UI_REFRESH_SECONDS=5
YOUPIN_LIVE_VERIFY_RPS=2.8
YOUPIN_LIVE_VERIFY_BURST=5
YOUPIN_LIVE_VERIFY_WORKERS=6
YOUPIN_LIVE_TIMEOUT_SECONDS=2.5
YOUPIN_LIVE_MAX_RETRIES=3
BACKOFF_BASE_SECONDS=0.4
BACKOFF_MAX_SECONDS=8.0
BACKOFF_JITTER_RATIO=0.2
SOURCE_MAX_SLOWDOWN=4.0
YOUPIN_ANOMALY_LOOKBACK=20
YOUPIN_ANOMALY_MIN_HISTORY=5
YOUPIN_ANOMALY_MULTIPLIER=2.0
ANOMALY_MAD_MULTIPLIER=6.0
ANOMALY_IQR_MULTIPLIER=2.5

# historical snapshot audit (internal, disabled by default)
SNAPSHOT_ON_CYCLE_COMPLETE=false
SNAPSHOT_RETENTION_DAYS=30

# operational warning thresholds
SLOWDOWN_WARN_THRESHOLD=2.5
ROLL_PRIORITY_QUEUE_WARN_SIZE=60

# system health check
HEALTH_CHECK_INTERVAL_SECONDS=60
HEALTH_CHECK_TTL_SECONDS=120
HEALTH_CHECK_PRICE_DEVIATION_THRESHOLD=0.5
HEALTH_CHECK_TIMESTAMP_SKEW_SECONDS=300
HEALTH_CHECK_DUPLICATE_WINDOW_SECONDS=60
